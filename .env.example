# ==========================================
# HEARME AI - ENVIRONMENT CONFIGURATION
# ==========================================

# Google Gemini API Key (Required for real AI Explainer, Summarizer & Assistant)
# Get your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Backend Server Port (Default: 5001)
PORT=5001

# Firebase Configuration (Optional - falls back gracefully to local persistence if not set)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
